# Qdrant Vector Database Configuration
# Obtain your cluster URL and API key from https://cloud.qdrant.io (or use local Qdrant http://localhost:6333)
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key

# LLM Provider: "gemini" (recommended) or "groq"
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Groq LLM API Configuration (Optional alternative from https://console.groq.com)
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
